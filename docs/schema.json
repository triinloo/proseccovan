    "POST /api/login": {
      "request": "LoginRequestDto",
      "response": "LoginResponseDto"
    },
    "POST /api/register": {
      "request": "RegisterRequestDto",
      "response": "UserDto"
    },
    "POST /api/bookings": {
      "request": "BookingRequestDto",
      "response": "BookingResponseDto"
    },
    "GET /api/bookings/my": {
      "response": "List<BookingResponseDto>"
    },
    "PUT /api/bookings/{id}": {
      "request": "BookingRequestDto",
      "response": "BookingResponseDto"
    },
    "GET /api/admin/bookings": {
      "params": "status? (OOTEL|KINNITATUD|TUHISTATUD), search?",
      "response": "List<BookingResponseDto>"
    },
    "GET /api/admin/bookings/{id}": {
      "response": "BookingResponseDto"
    },
    "PATCH /api/admin/bookings/{id}/status": {
      "request": "{ status: BookingStatus }",
      "response": "BookingResponseDto"
    },
    "POST /api/admin/bookings/{id}/email": {
      "response": "void"
    },
    "GET /api/events": {
      "params": "season? (SUVI|SUGIS|KEVAD|TALV)",
      "response": "List<EventResponseDto>"
    },
    "POST /api/admin/events": {
      "request": "EventRequestDto (multipart)",
      "response": "EventResponseDto"
    },
    "PUT /api/admin/events/{id}": {
      "request": "EventRequestDto (multipart)",
      "response": "EventResponseDto"
    },
    "DELETE /api/admin/events/{id}": {
      "response": "void"
    }
